# Arquivo: .env.exemplo
# Copie para .env antes de rodar. Nunca versione o .env de verdade.

# SQLite em desenvolvimento. Em producao troque pela URL do PostgreSQL.
DATABASE_URL="file:./dev.db"

# Segredo usado pra assinar os links de midia (playlists e segmentos HLS).
# Em producao o servidor se recusa a servir midia com o valor de exemplo abaixo.
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SEGREDO_SESSAO="troque-este-valor-por-uma-string-longa-e-aleatoria"

# Porta do servidor. Fixamos 4000 pra nao conflitar com outros projetos locais.
PORT=4000
ORIGIN="http://localhost:4000"

# Pastas de midia (ficam fora do git)
PASTA_UPLOADS="./midia/originais"
PASTA_HLS="./midia/hls"

# Caminho do binario do ffmpeg. Deixe "ffmpeg" se ja estiver no PATH.
CAMINHO_FFMPEG="ffmpeg"

# Envio de e-mail (verificacao de conta e recuperacao de senha).
# console = imprime a mensagem no terminal (padrao, otimo pra desenvolver)
# arquivo = grava uma linha JSON por mensagem em EMAIL_ARQUIVO
# resend  = envia de verdade pela API do Resend
EMAIL_TRANSPORTE="console"
EMAIL_ARQUIVO="./midia/emails.jsonl"
EMAIL_REMETENTE="Yokira Animes <nao-responda@yokira.local>"
RESEND_API_KEY=""

# Conta de administrador criada pelo seed.
ADMIN_EMAIL="admin@yokira.local"
ADMIN_SENHA="YokiraAdmin#2024"
